<!--
    Settings dialog. Every control binds straight to the panel's view model, so a change applies
    to the panel as soon as it is made; there is nothing to confirm, only DONE to close.
    Built entirely from the shared Casebook styles (Themes/VictorianTheme.xaml).
-->
<Window x:Class="TimeCountdown.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimeCountdown.ViewModels"
        xmlns:views="clr-namespace:TimeCountdown.Views"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding [Window.Settings.Title], Source={StaticResource Loc}}"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=AlwaysOnTopBox}">

    <Window.Resources>
        <views:SelectionWriteBackConverter x:Key="SelectionWriteBack" />
    </Window.Resources>

    <!-- The transparent margin leaves room for the sheet's shadow, which falls down and right. -->
    <Border Style="{StaticResource Surface.Sheet}"
            Margin="24,16,24,32"
            MouseLeftButtonDown="Sheet_OnMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The sections scroll once the window reaches its work-area cap (set in code), while
                 the DONE row below stays in view. The ScrollViewer is not focusable: a focusable one
                 takes focus on every click on the paper and marks the press handled, which would stop
                 the sheet from being dragged. The side padding sits on the content rather than the
                 viewer so keyboard focus rings at the edges are not clipped by the scrolling area;
                 at the top and bottom edges the code-behind scrolls a little further for the same
                 reason (Sections_OnRequestBringIntoView). -->
            <ScrollViewer x:Name="Body"
                          Focusable="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40,32,40,8"
                            RequestBringIntoView="Sections_OnRequestBringIntoView">

                    <!-- Heading -->
                    <TextBlock Style="{StaticResource Text.DialogTitle}"
                               AutomationProperties.HeadingLevel="Level1"
                               Text="{Binding [Settings.Heading], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" />
                    <TextBlock Style="{StaticResource Text.Emphasis}"
                               Margin="0,12,0,0"
                               TextAlignment="Center"
                               Text="{Binding [Settings.Subtitle], Source={StaticResource Loc}}" />

                    <!-- I · Display -->
                    <TextBlock Style="{StaticResource Text.SectionHeading}"
                               Margin="0,32,0,0"
                               AutomationProperties.HeadingLevel="Level2"
                               Text="{Binding [Settings.Section.Display], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" />

                    <CheckBox x:Name="AlwaysOnTopBox"
                              Style="{StaticResource CheckBox.Field}"
                              Margin="0,16,0,0"
                              Content="{Binding [Settings.AlwaysOnTop], Source={StaticResource Loc}}"
                              IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Style="{StaticResource CheckBox.Field}"
                              Margin="0,12,0,0"
                              Content="{Binding [Settings.DesktopLayer], Source={StaticResource Loc}}"
                              AutomationProperties.HelpText="{Binding [Settings.DesktopLayerHint], Source={StaticResource Loc}}"
                              IsChecked="{Binding DesktopLayerEnabled}" />
                    <!-- Indented by the check box's 16 DIP box and 8 DIP gap so it lines up with the label. -->
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="24,4,0,0"
                               Text="{Binding [Settings.DesktopLayerHint], Source={StaticResource Loc}}" />

                    <!-- The readout shows the opacity in force, which is 100% under a contrast theme. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding [Settings.PanelOpacity], Source={StaticResource Loc}}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Text.Body}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontWeight="SemiBold"
                                   Text="{Binding EffectivePanelOpacity, StringFormat={}{0:P0}}" />
                    </Grid>
                    <!-- Snaps to whole percents so the arrow keys, the readout and the saved value agree.
                         ValueText makes screen readers announce the readout ("96%"), not the bare 0.96;
                         the threshold sliders below do the same with their day counts. -->
                    <views:ValueTextSlider Margin="0,4,0,0"
                                           Minimum="{x:Static vm:MainWindowViewModel.MinPanelOpacity}"
                                           Maximum="{x:Static vm:MainWindowViewModel.MaxPanelOpacity}"
                                           SmallChange="0.01"
                                           LargeChange="0.05"
                                           TickFrequency="0.01"
                                           IsSnapToTickEnabled="True"
                                           ValueText="{Binding EffectivePanelOpacity, StringFormat={}{0:P0}}"
                                           AutomationProperties.Name="{Binding [Settings.PanelOpacity], Source={StaticResource Loc}}">
                        <views:ValueTextSlider.Style>
                            <Style TargetType="Slider" BasedOn="{StaticResource Slider.Field}">
                                <!-- Bound in the style, not on the element, so the trigger below can replace it. -->
                                <Setter Property="Value" Value="{Binding PanelOpacity}" />
                                <Style.Triggers>
                                    <!-- A contrast theme forces the panel opaque, so the setting has no effect
                                         there: the slider is locked at the opacity in force, agreeing with the
                                         readout and the caption, and the saved value returns with the theme. -->
                                    <DataTrigger Binding="{Binding IsHighContrast}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Value" Value="{Binding EffectivePanelOpacity, Mode=OneWay}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ValueTextSlider.Style>
                    </views:ValueTextSlider>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"
                               Visibility="{Binding IsHighContrast, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="{Binding [Settings.PanelOpacityHighContrast], Source={StaticResource Loc}}" />

                    <!-- II · Behaviour -->
                    <TextBlock Style="{StaticResource Text.SectionHeading}"
                               Margin="0,32,0,0"
                               AutomationProperties.HeadingLevel="Level2"
                               Text="{Binding [Settings.Section.Behavior], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" />

                    <!-- A real radio group, so assistive technology reports which language is selected.
                         The group box exposes its header as the group's name, the way a fieldset's
                         legend does, so the choices are announced under "Language" rather than as two
                         unrelated words; the box itself draws nothing and takes no focus. -->
                    <GroupBox Margin="0,16,0,0"
                              Header="{Binding [Settings.Language], Source={StaticResource Loc}}">
                        <GroupBox.Template>
                            <ControlTemplate TargetType="GroupBox">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}"
                                               Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <!-- Pulled left by the segment padding so the first word lines up with the label. -->
                                    <ContentPresenter Margin="-10,4,0,0" />
                                </StackPanel>
                            </ControlTemplate>
                        </GroupBox.Template>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource RadioButton.Segment}"
                                         GroupName="Language"
                                         Content="{Binding [Language.English], Source={StaticResource Loc}}"
                                         IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}" />
                            <Border Width="1"
                                    Height="16"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource RuleBrush}" />
                            <RadioButton Style="{StaticResource RadioButton.Segment}"
                                         GroupName="Language"
                                         Language="zh-CN"
                                         Content="{Binding [Language.Chinese], Source={StaticResource Loc}}"
                                         IsChecked="{Binding IsChineseSelected, Mode=TwoWay}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- The unpackaged build registers itself to run at sign-in, which Windows or a policy
                         can refuse. The box then snaps back and the reason appears beneath it: the panel
                         reports it too, but the panel is hidden behind this dialog. The reason is also
                         the box's help text, so it is read again whenever the box gets focus. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsPackaged, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <CheckBox Style="{StaticResource CheckBox.Field}"
                                  Content="{Binding [Settings.Startup], Source={StaticResource Loc}}"
                                  AutomationProperties.HelpText="{Binding Text, ElementName=StartupError}"
                                  IsChecked="{Binding LaunchAtStartup}" />
                        <TextBlock x:Name="StartupError"
                                   Margin="24,4,0,0"
                                   AutomationProperties.LiveSetting="Assertive">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Error}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- The MSIX build's startup task can only be switched in Windows Settings. -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsPackaged, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource Text.Label}"
                                   Text="{Binding [Settings.Startup], Source={StaticResource Loc}}" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,0"
                                   Text="{Binding [Settings.StartupPackagedHint], Source={StaticResource Loc}}" />
                        <Button Style="{StaticResource Button.Link}"
                                Margin="-6,4,0,0"
                                HorizontalAlignment="Left"
                                Click="OpenStartupSettings_Click"
                                Content="{Binding [Settings.StartupOpenSettings], Source={StaticResource Loc}}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource CheckBox.Field}"
                              Margin="0,12,0,0"
                              Content="{Binding [Settings.HideToTray], Source={StaticResource Loc}}"
                              IsChecked="{Binding HideOnCloseToTray}" />

                    <!-- Both option lists are rebuilt on a language switch; SelectionWriteBack keeps the
                         boxes showing the saved choice afterwards (see the converter). -->
                    <TextBlock Style="{StaticResource Text.Label}"
                               Margin="0,16,0,0"
                               Text="{Binding [Settings.DefaultReminder], Source={StaticResource Loc}}" />
                    <ComboBox Style="{StaticResource ComboBox.Field}"
                              Margin="0,4,0,0"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Minutes"
                              ItemsSource="{Binding ReminderOptions}"
                              SelectedValue="{Binding DefaultReminderMinutesBefore, Converter={StaticResource SelectionWriteBack}}"
                              AutomationProperties.Name="{Binding [Settings.DefaultReminder], Source={StaticResource Loc}}" />

                    <TextBlock Style="{StaticResource Text.Label}"
                               Margin="0,16,0,0"
                               Text="{Binding [Settings.DefaultTimeZone], Source={StaticResource Loc}}" />
                    <ComboBox Style="{StaticResource ComboBox.Field}"
                              Margin="0,4,0,0"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              ItemsSource="{Binding TimeZoneOptions}"
                              SelectedValue="{Binding DefaultTimeZoneId, Converter={StaticResource SelectionWriteBack}}"
                              AutomationProperties.Name="{Binding [Settings.DefaultTimeZone], Source={StaticResource Loc}}" />

                    <!-- III · Thresholds -->
                    <TextBlock Style="{StaticResource Text.SectionHeading}"
                               Margin="0,32,0,0"
                               AutomationProperties.HeadingLevel="Level2"
                               Text="{Binding [Settings.Section.Thresholds], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,16,0,0"
                               Text="{Binding [Settings.ThresholdHint], Source={StaticResource Loc}}" />

                    <!-- Each limit reads as a sentence: the label on the left, its value in days on the
                         right, the slider full width beneath. Keeping the value off the slider's row means
                         a readout that changes width while dragging never resizes the track under the
                         pointer. The ranges come from the view model, so the track only offers values it
                         accepts. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding [Settings.Threshold.Perilous], Source={StaticResource Loc}}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Text.Body}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontWeight="SemiBold"
                                   Text="{Binding PerilousThresholdText}" />
                    </Grid>
                    <views:ValueTextSlider Style="{StaticResource Slider.Field}"
                                           Margin="0,4,0,0"
                                           Minimum="{Binding MinPerilousThresholdDays, Mode=OneTime}"
                                           Maximum="{Binding MaxPerilousThresholdDays, Mode=OneTime}"
                                           SmallChange="1"
                                           LargeChange="7"
                                           TickFrequency="1"
                                           IsSnapToTickEnabled="True"
                                           Value="{Binding PerilousThresholdDays}"
                                           ValueText="{Binding PerilousThresholdText}"
                                           AutomationProperties.Name="{Binding [Settings.Threshold.Perilous], Source={StaticResource Loc}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding [Settings.Threshold.Urgent], Source={StaticResource Loc}}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Text.Body}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontWeight="SemiBold"
                                   Text="{Binding UrgentThresholdText}" />
                    </Grid>
                    <!-- The lower bound moves with the Perilous limit: Urgent is always at least a day later. -->
                    <views:ValueTextSlider Style="{StaticResource Slider.Field}"
                                           Margin="0,4,0,0"
                                           Minimum="{Binding MinUrgentThresholdDays}"
                                           Maximum="{Binding MaxUrgentThresholdDays, Mode=OneTime}"
                                           SmallChange="1"
                                           LargeChange="7"
                                           TickFrequency="1"
                                           IsSnapToTickEnabled="True"
                                           Value="{Binding UrgentThresholdDays}"
                                           ValueText="{Binding UrgentThresholdText}"
                                           AutomationProperties.Name="{Binding [Settings.Threshold.Urgent], Source={StaticResource Loc}}" />

                    <!-- IV · Placement -->
                    <TextBlock Style="{StaticResource Text.SectionHeading}"
                               Margin="0,32,0,0"
                               AutomationProperties.HeadingLevel="Level2"
                               Text="{Binding [Settings.Section.Placement], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,16,0,0"
                               Text="{Binding [Settings.PlacementHint], Source={StaticResource Loc}}" />
                    <Button x:Name="ResetPlacementButton"
                            Style="{StaticResource Button.Link}"
                            Margin="-6,4,0,0"
                            HorizontalAlignment="Left"
                            Click="ResetPlacement_Click"
                            Content="{Binding [Settings.ResetPlacement], Source={StaticResource Loc}}" />

                    <!-- V · About -->
                    <TextBlock Style="{StaticResource Text.SectionHeading}"
                               Margin="0,32,0,0"
                               AutomationProperties.HeadingLevel="Level2"
                               Text="{Binding [Settings.Section.About], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,16,0,0">
                        <Run Text="{Binding [App.Name], Source={StaticResource Loc}, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="·" Foreground="{DynamicResource InkFaintBrush}" />
                        <Run Text="{Binding [Settings.About.Version], Source={StaticResource Loc}, Mode=OneWay}" />
                        <Run x:Name="VersionRun" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,4,0,0"
                               Text="{Binding [Settings.About.License], Source={StaticResource Loc}}" />
                    <WrapPanel Margin="-6,4,0,0">
                        <Button x:Name="LegalNoticesButton"
                                Style="{StaticResource Button.Link}"
                                Margin="0,0,12,0"
                                Click="LegalNotices_Click"
                                Content="{Binding [Settings.About.Notices], Source={StaticResource Loc}}" />
                        <Button Style="{StaticResource Button.Link}"
                                Margin="0,0,12,0"
                                Click="ReportProblem_Click"
                                Content="{Binding [Settings.About.ReportProblem], Source={StaticResource Loc}}" />
                        <Button Style="{StaticResource Button.Link}"
                                Click="OpenLogs_Click"
                                Content="{Binding [Settings.About.OpenLogs], Source={StaticResource Loc}}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Pinned command row. A hairline appears above it only while the sections scroll
                 beneath it, so cut-off content reads as scrolled rather than clipped. -->
            <Border Grid.Row="1" BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=Body}" Value="Visible">
                                <Setter Property="BorderBrush" Value="{DynamicResource PaperEdgeBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Settings apply live, so DONE is both the default (Enter) and the cancel (Esc) action. -->
                <Button Style="{StaticResource Button.Secondary}"
                        Margin="40,16,40,24"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        IsCancel="True"
                        Click="Done_Click"
                        Content="{Binding [Settings.Done], Source={StaticResource Loc}}" />
            </Border>
        </Grid>
    </Border>
</Window>
