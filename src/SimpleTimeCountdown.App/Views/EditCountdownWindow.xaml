<Window x:Class="TimeCountdown.Views.EditCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeCountdown.Controls"
        xmlns:services="clr-namespace:TimeCountdown.Services"
        xmlns:views="clr-namespace:TimeCountdown.Views"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding WindowTitle}"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TitleTextBox}">

    <Window.Resources>
        <!-- Inline validation message under a field: collapsed until the view model publishes
             one. The window announces it when a save attempt fails. -->
        <Style x:Key="Editor.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Error}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Counters and advisory notes: shown only while the view model has something to say.
             They are polite live regions, announced by the window when they appear. -->
        <Style x:Key="Editor.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The time-zone and reminder choices are records shown through DisplayMemberPath.
             Without a name, their automation peers fall back to the record's ToString(), so a
             screen reader would read "TimeZoneOption { Id = ... }"; name each item by its text. -->
        <Style x:Key="Editor.TimeZoneItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Field}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>
        <Style x:Key="Editor.ReminderItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Field}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        </Style>
        <!-- Hours and minutes are read as they are shown: "05", not "5". -->
        <Style x:Key="Editor.TwoDigitItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem.Field}">
            <Setter Property="AutomationProperties.Name" Value="{Binding StringFormat=00}" />
        </Style>
    </Window.Resources>

    <!-- The transparent margin leaves room for the sheet's shadow. -->
    <Border Style="{StaticResource Surface.Sheet}"
            Margin="24,20,24,32"
            MouseLeftButtonDown="Sheet_OnMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <!-- The form scrolls when the dialog reaches the height of the work area, so the
                     actions below it always stay on screen. -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Focusable="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,32,40,0">
                    <!-- Centred text stretches to the full width, so a heading or line that
                         nearly fills it wraps cleanly instead of depending on its exact measure. -->
                    <TextBlock Style="{StaticResource Text.DialogTitle}" HorizontalAlignment="Stretch" Text="{Binding Heading}" />
                    <Separator Style="{StaticResource Ornament.DiamondRule}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Text.Emphasis}"
                               Margin="0,12,0,0"
                               TextAlignment="Center"
                               Text="{Binding [Editor.Instructions], Source={StaticResource Loc}}" />
                    <Separator Style="{StaticResource Ornament.DoubleRule}" Margin="0,16,0,0" />

                    <!-- Title (required) -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleLabel"
                                   Style="{StaticResource Text.Label}"
                                   Text="{Binding [Editor.Label.Title], Source={StaticResource Loc}}" />
                        <!-- Visible cue; IsRequiredForForm on the field carries it to assistive tech. -->
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="8,0,0,0"
                                   FontStyle="{DynamicResource EmphasisFontStyle}"
                                   Text="{Binding [Editor.Required], Source={StaticResource Loc}}" />
                        <TextBlock x:Name="TitleCounterText"
                                   Grid.Column="2"
                                   Style="{StaticResource Editor.Caption}"
                                   Margin="12,0,0,0"
                                   TextWrapping="NoWrap"
                                   AutomationProperties.Name="{Binding TitleCounterSpoken}"
                                   Text="{Binding TitleCounter}" />
                    </Grid>
                    <!-- All three text fields wrap (Enter still saves, since none accepts
                         returns), so long input stays readable while it is written; past about
                         four lines a field scrolls. -->
                    <TextBox x:Name="TitleTextBox"
                             Style="{StaticResource TextBox.Field}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             MaxHeight="84"
                             MaxLength="{x:Static services:TextInput.MaxTitleLength}"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             DataObject.Pasting="TextField_OnPasting"
                             AutomationProperties.LabeledBy="{Binding ElementName=TitleLabel}"
                             AutomationProperties.IsRequiredForForm="True"
                             AutomationProperties.HelpText="{Binding TitleHelp}" />
                    <TextBlock x:Name="TitleErrorText" Style="{StaticResource Editor.Error}" Text="{Binding TitleError}" />

                    <!-- Note -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NoteLabel"
                                   Style="{StaticResource Text.Label}"
                                   Text="{Binding [Editor.Label.Note], Source={StaticResource Loc}}" />
                        <TextBlock x:Name="NoteCounterText"
                                   Grid.Column="1"
                                   Style="{StaticResource Editor.Caption}"
                                   Margin="12,0,0,0"
                                   TextWrapping="NoWrap"
                                   AutomationProperties.Name="{Binding NoteCounterSpoken}"
                                   Text="{Binding NoteCounter}" />
                    </Grid>
                    <TextBox x:Name="NoteTextBox"
                             Style="{StaticResource TextBox.Field}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             MaxHeight="84"
                             MaxLength="{x:Static services:TextInput.MaxNoteLength}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             DataObject.Pasting="TextField_OnPasting"
                             AutomationProperties.LabeledBy="{Binding ElementName=NoteLabel}"
                             AutomationProperties.HelpText="{Binding NoteCounterSpoken}" />

                    <!-- Due date: a full-width row. The date is written out in the user's regional
                         long format, with the weekday and month in full, and in about one culture
                         in five that no longer fits beside the hour and minute. -->
                    <TextBlock x:Name="DateLabel"
                               Style="{StaticResource Text.Label}"
                               Margin="0,16,0,0"
                               Text="{Binding [Editor.Label.Date], Source={StaticResource Loc}}" />
                    <!-- LabeledBy does not name a DatePicker, but its Name and HelpText are
                         forwarded to the inner text box that actually takes focus. -->
                    <DatePicker x:Name="DueDatePicker"
                                Margin="0,4,0,0"
                                PreviewKeyDown="DueDatePicker_OnPreviewKeyDown"
                                DateValidationError="DueDatePicker_OnDateValidationError"
                                SelectedDate="{Binding Date}"
                                SelectedDateFormat="Long"
                                DisplayDateStart="{x:Static views:EditCountdownViewModel.MinDate}"
                                DisplayDateEnd="{x:Static views:EditCountdownViewModel.MaxDate}"
                                AutomationProperties.Name="{Binding [Editor.Label.Date], Source={StaticResource Loc}}"
                                AutomationProperties.IsRequiredForForm="True"
                                AutomationProperties.HelpText="{Binding DateError}" />
                    <TextBlock x:Name="DateErrorText" Style="{StaticResource Editor.Error}" Text="{Binding DateError}" />

                    <!-- Due time: hour and minute, two digits each. Left-aligned, because a grid of
                         fixed columns stretched across the form spreads layout-rounding leftovers
                         into them (84 DIP became 85). -->
                    <Grid Margin="0,16,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="HourLabel"
                                   Style="{StaticResource Text.Label}"
                                   Text="{Binding [Editor.Label.Hour], Source={StaticResource Loc}}" />
                        <ComboBox x:Name="HourComboBox"
                                  Grid.Row="1"
                                  Margin="0,4,0,0"
                                  Style="{StaticResource ComboBox.Field}"
                                  ItemsSource="{Binding Hours}"
                                  ItemStringFormat="00"
                                  ItemContainerStyle="{StaticResource Editor.TwoDigitItem}"
                                  SelectedItem="{Binding Hour}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=HourLabel}"
                                  AutomationProperties.HelpText="{Binding TimeError}" />

                        <TextBlock x:Name="MinuteLabel"
                                   Grid.Column="2"
                                   Style="{StaticResource Text.Label}"
                                   Text="{Binding [Editor.Label.Minute], Source={StaticResource Loc}}" />
                        <ComboBox x:Name="MinuteComboBox"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Margin="0,4,0,0"
                                  Style="{StaticResource ComboBox.Field}"
                                  ItemsSource="{Binding Minutes}"
                                  ItemStringFormat="00"
                                  ItemContainerStyle="{StaticResource Editor.TwoDigitItem}"
                                  SelectedItem="{Binding Minute}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=MinuteLabel}"
                                  AutomationProperties.HelpText="{Binding TimeError}" />
                    </Grid>
                    <TextBlock x:Name="TimeErrorText" Style="{StaticResource Editor.Error}" Text="{Binding TimeError}" />
                    <TextBlock x:Name="ScheduleNoteText"
                               Style="{StaticResource Editor.Caption}"
                               Margin="0,4,0,0"
                               Text="{Binding ScheduleNote}" />

                    <!-- Time zone: a full-width row, because zone names are long. -->
                    <TextBlock x:Name="TimeZoneLabel"
                               Style="{StaticResource Text.Label}"
                               Margin="0,16,0,0"
                               Text="{Binding [Editor.Label.TimeZone], Source={StaticResource Loc}}" />
                    <ComboBox x:Name="TimeZoneComboBox"
                              Margin="0,4,0,0"
                              Style="{StaticResource ComboBox.Field}"
                              ItemsSource="{Binding TimeZoneOptions}"
                              DisplayMemberPath="DisplayName"
                              ItemContainerStyle="{StaticResource Editor.TimeZoneItem}"
                              SelectedItem="{Binding TimeZone}"
                              AutomationProperties.LabeledBy="{Binding ElementName=TimeZoneLabel}"
                              AutomationProperties.HelpText="{Binding TimeZoneError}" />
                    <TextBlock x:Name="TimeZoneErrorText" Style="{StaticResource Editor.Error}" Text="{Binding TimeZoneError}" />

                    <!-- Reminder -->
                    <TextBlock x:Name="ReminderLabel"
                               Style="{StaticResource Text.Label}"
                               Margin="0,16,0,0"
                               Text="{Binding [Editor.Label.Reminder], Source={StaticResource Loc}}" />
                    <ComboBox x:Name="ReminderComboBox"
                              Margin="0,4,0,0"
                              Style="{StaticResource ComboBox.Field}"
                              ItemsSource="{Binding ReminderOptions}"
                              DisplayMemberPath="Label"
                              ItemContainerStyle="{StaticResource Editor.ReminderItem}"
                              SelectedItem="{Binding Reminder}"
                              AutomationProperties.LabeledBy="{Binding ElementName=ReminderLabel}"
                              AutomationProperties.HelpText="{Binding ReminderError}" />
                    <TextBlock x:Name="ReminderErrorText" Style="{StaticResource Editor.Error}" Text="{Binding ReminderError}" />

                    <CheckBox Style="{StaticResource CheckBox.Field}"
                              Margin="0,20,0,0"
                              IsChecked="{Binding IsPinned}"
                              Content="{Binding [Editor.Label.Pin], Source={StaticResource Loc}}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="40,20,40,28">
                <Separator Style="{StaticResource Ornament.DoubleRule}" />
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Primary}"
                            IsDefault="True"
                            Content="{Binding SaveText}"
                            Click="Save_Click" />
                    <!-- IsCancel closes the modal dialog with DialogResult false, on click or Esc. -->
                    <Button Style="{StaticResource Button.Secondary}"
                            Margin="12,0,0,0"
                            IsCancel="True"
                            Content="{Binding [Editor.Cancel], Source={StaticResource Loc}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
