<Window x:Class="TimeCountdown.Views.EditCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [Window.Editor.Title], Source={StaticResource Loc}}"
        Width="540"
        SizeToContent="Height"
        MinWidth="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- ===== Vellum palette (scoped to this window only) ===== -->
        <SolidColorBrush x:Key="VellumPaperBrush" Color="#EDE3CE" />
        <SolidColorBrush x:Key="VellumPaperEdgeBrush" Color="#D8C9A6" />
        <SolidColorBrush x:Key="VellumInkBrush" Color="#1F1A12" />
        <SolidColorBrush x:Key="VellumInkSoftBrush" Color="#3A2F22" />
        <SolidColorBrush x:Key="VellumOxbloodBrush" Color="#7A2E2E" />
        <SolidColorBrush x:Key="VellumGrayBrush" Color="#6B5A3F" />
        <SolidColorBrush x:Key="VellumGrayFaintBrush" Color="#8A7654" />

        <FontFamily x:Key="VellumSerif">Georgia, "Source Serif Pro", Cambria, Garamond, "Noto Serif SC", "Microsoft YaHei UI", "SimSun"</FontFamily>

        <!-- Bilingual section label: ALL CAPS English + middle dot + 中文 -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource VellumSerif}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStretch" Value="Expanded" />
            <Setter Property="Foreground" Value="{StaticResource VellumGrayBrush}" />
        </Style>

        <!-- Borderless "writing line" text box -->
        <Style x:Key="WritingLineTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,0.6" />
            <Setter Property="Foreground" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource VellumGrayFaintBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource VellumSerif}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0,3,0,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource VellumOxbloodBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom writing-line shared by DatePicker / ComboBox rows -->
        <Style x:Key="WritingLine" TargetType="Border">
            <Setter Property="Height" Value="0.6" />
            <Setter Property="Background" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Primary action button: solid ink fill, paper text -->
        <Style x:Key="PrimaryInkButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="Foreground" Value="{StaticResource VellumPaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="FontFamily" Value="{StaticResource VellumSerif}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStretch" Value="Expanded" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource VellumOxbloodBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VellumOxbloodBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource VellumInkSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action button: transparent fill, hairline ink frame -->
        <Style x:Key="SecondaryFrameButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource VellumInkBrush}" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="FontFamily" Value="{StaticResource VellumSerif}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStretch" Value="Expanded" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VellumOxbloodBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource VellumOxbloodBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pin checkbox (kept simple; tinted to vellum gray) -->
        <Style x:Key="VellumCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ParchmentCheckBox}">
            <Setter Property="Foreground" Value="{StaticResource VellumGrayBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource VellumSerif}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStretch" Value="Expanded" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Border Background="{StaticResource VellumPaperBrush}"
                BorderBrush="{StaticResource VellumPaperEdgeBrush}"
                BorderThickness="0.5"
                MouseLeftButtonDown="WindowSurface_OnMouseLeftButtonDown"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#3C2814" />
            </Border.Effect>
            <Border.RenderTransform>
                <RotateTransform Angle="-1.2" />
            </Border.RenderTransform>

            <Grid Margin="44,32,44,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           x:Name="HeadingText"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource VellumSerif}"
                           FontSize="22"
                           FontWeight="Normal"
                           FontStretch="Expanded"
                           Foreground="{StaticResource VellumInkBrush}" />

                <!-- Diamond ornament under title -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontFamily="{StaticResource VellumSerif}"
                           FontSize="11"
                           Foreground="{StaticResource VellumGrayFaintBrush}"
                           Text="◆ &#x2003;·&#x2003; ◆ &#x2003;·&#x2003; ◆" />

                <!-- Italic instruction line, em-dash bookended -->
                <TextBlock Grid.Row="2"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           FontFamily="{StaticResource VellumSerif}"
                           FontStyle="Italic"
                           FontSize="12"
                           Foreground="{StaticResource VellumGrayBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding [Editor.Instructions], Source={StaticResource Loc}}" />

                <!-- Double rule -->
                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <Border Height="0.6" Background="{StaticResource VellumInkBrush}" Opacity="0.7" SnapsToDevicePixels="True" />
                    <Border Height="0.6" Background="{StaticResource VellumInkBrush}" Opacity="0.7" Margin="0,3,0,0" SnapsToDevicePixels="True" />
                </StackPanel>

                <!-- SUBJECT -->
                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Subject], Source={StaticResource Loc}}" />
                    <TextBox x:Name="TitleTextBox"
                             Style="{StaticResource WritingLineTextBox}"
                             Margin="0,4,0,0" />
                </StackPanel>

                <!-- NOTE -->
                <StackPanel Grid.Row="5" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Note], Source={StaticResource Loc}}" />
                    <TextBox x:Name="SubtitleTextBox"
                             Style="{StaticResource WritingLineTextBox}"
                             Margin="0,4,0,0" />
                </StackPanel>

                <!-- MARGINALIA -->
                <StackPanel Grid.Row="6" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Marginalia], Source={StaticResource Loc}}" />
                    <TextBox x:Name="TagsTextBox"
                             Style="{StaticResource WritingLineTextBox}"
                             Margin="0,4,0,0" />
                </StackPanel>

                <!-- DUE ON / HR / MIN -->
                <Grid Grid.Row="7" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.DueOn], Source={StaticResource Loc}}" />
                        <Grid Margin="0,4,0,0">
                            <DatePicker x:Name="TargetDatePicker"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="{StaticResource VellumSerif}"
                                        FontSize="15"
                                        Foreground="{StaticResource VellumInkBrush}" />
                            <Border Style="{StaticResource WritingLine}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Hour], Source={StaticResource Loc}}" />
                        <Grid Margin="0,4,0,0">
                            <ComboBox x:Name="HourComboBox"
                                      Style="{StaticResource ParchmentComboBox}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontFamily="{StaticResource VellumSerif}"
                                      FontSize="15" />
                            <Border Style="{StaticResource WritingLine}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Minute], Source={StaticResource Loc}}" />
                        <Grid Margin="0,4,0,0">
                            <ComboBox x:Name="MinuteComboBox"
                                      Style="{StaticResource ParchmentComboBox}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontFamily="{StaticResource VellumSerif}"
                                      FontSize="15" />
                            <Border Style="{StaticResource WritingLine}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- DISPOSITION / ALERT -->
                <Grid Grid.Row="8" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Disposition], Source={StaticResource Loc}}" />
                        <Grid Margin="0,4,0,0">
                            <ComboBox x:Name="TimeZoneComboBox"
                                      Style="{StaticResource ParchmentComboBox}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontFamily="{StaticResource VellumSerif}"
                                      FontSize="14"
                                      DisplayMemberPath="DisplayName" />
                            <Border Style="{StaticResource WritingLine}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Editor.Label.Alert], Source={StaticResource Loc}}" />
                        <Grid Margin="0,4,0,0">
                            <ComboBox x:Name="ReminderComboBox"
                                      Style="{StaticResource ParchmentComboBox}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontFamily="{StaticResource VellumSerif}"
                                      FontSize="14"
                                      DisplayMemberPath="Label" />
                            <Border Style="{StaticResource WritingLine}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- PIN -->
                <CheckBox Grid.Row="9"
                          x:Name="PinnedCheckBox"
                          Style="{StaticResource VellumCheckBox}"
                          Margin="0,18,0,0"
                          Content="{Binding [Editor.Label.Pin], Source={StaticResource Loc}}" />

                <!-- Double rule -->
                <StackPanel Grid.Row="10" Margin="0,20,0,0">
                    <Border Height="0.6" Background="{StaticResource VellumInkBrush}" Opacity="0.7" SnapsToDevicePixels="True" />
                    <Border Height="0.6" Background="{StaticResource VellumInkBrush}" Opacity="0.7" Margin="0,3,0,0" SnapsToDevicePixels="True" />
                </StackPanel>

                <!-- Action row: primary INSCRIBE on left, secondary LEAVE on right -->
                <Grid Grid.Row="11" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="SaveButton"
                            Style="{StaticResource PrimaryInkButton}"
                            Click="Save_Click"
                            IsDefault="True" />
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryFrameButton}"
                            Click="Cancel_Click"
                            Content="{Binding [Common.Leave], Source={StaticResource Loc}}"
                            IsCancel="True" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
