<Window x:Class="TimeCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TimeCountdown.ViewModels"
        xmlns:controls="clr-namespace:TimeCountdown.Controls"
        mc:Ignorable="d"
        Title="{Binding [Window.Main.Title], Source={StaticResource Loc}}"
        Width="520"
        Height="820"
        MinWidth="420"
        MinHeight="600"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource SerifFont}"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Closing="Window_OnClosing"
        Activated="Window_OnActivated"
        LocationChanged="Window_OnLocationOrSizeChanged"
        SizeChanged="Window_OnLocationOrSizeChanged">

    <!-- Single parchment sheet — paper edge feel, no wood frame -->
    <Border Margin="28,22,28,32"
            Background="{StaticResource PaperBrush}"
            BorderBrush="{StaticResource PaperEdgeBrush}"
            BorderThickness="1"
            Opacity="{Binding PanelOpacity}"
            PreviewMouseLeftButtonDown="WindowSurface_OnPreviewMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="300" Opacity="0.28" Color="#3C2814" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top chrome bar -->
            <Border Grid.Row="0"
                    Height="38"
                    Background="{StaticResource PaperDeepBrush}"
                    BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource ChromeIconButton}"
                                Click="ToggleSearch_Click"
                                Margin="0"
                                ToolTip="{Binding [Main.Search.Tooltip], Source={StaticResource Loc}}">
                            <Canvas Width="14" Height="14">
                                <Ellipse Width="8" Height="8"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.2"
                                         Canvas.Left="1" Canvas.Top="1" />
                                <Line X1="7.5" Y1="7.5" X2="12" Y2="12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" />
                            </Canvas>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource ChromeIconButton}"
                                Click="AddCountdown_Click"
                                ToolTip="{Binding [Main.Button.New], Source={StaticResource Loc}}">
                            <Grid Width="14" Height="14">
                                <Line X1="7" Y1="2" X2="7" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                                <Line X1="2" Y1="7" X2="12" Y2="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ChromeIconButton}"
                                Click="OpenSettings_Click"
                                ToolTip="{Binding [Main.Button.Settings], Source={StaticResource Loc}}">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  Fill="Transparent"
                                  Data="M 7 2 L 8.2 4 L 10.5 3.6 L 11 5.8 L 13 6.5 L 12.4 8.5 L 13.6 10.4 L 11.8 11.6 L 11.4 13.4 L 9.2 13 L 7 14 L 4.8 13 L 2.6 13.4 L 2.2 11.6 L 0.4 10.4 L 1.6 8.5 L 1 6.5 L 3 5.8 L 3.5 3.6 L 5.8 4 Z M 7 5.5 A 1.6 1.6 0 1 0 7.001 5.5" />
                        </Button>
                        <Button Style="{StaticResource ChromeIconButton}"
                                Click="ToggleArchiveView_Click"
                                ToolTip="{Binding ArchiveViewTooltipText}">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.1"
                                  Fill="Transparent"
                                  Data="M 1 4 L 13 4 L 13 12 L 1 12 Z M 1 6.5 L 13 6.5 M 5.5 9 L 8.5 9" />
                        </Button>
                        <Button Style="{StaticResource ChromeIconButton}"
                                Click="HideWindow_Click"
                                ToolTip="{Binding [Main.Button.Hide], Source={StaticResource Loc}}">
                            <Line X1="3" Y1="11" X2="11" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                        </Button>
                        <Button Style="{StaticResource ChromeIconButton}"
                                Click="ExitWindow_Click"
                                ToolTip="{Binding [Main.Button.Exit], Source={StaticResource Loc}}"
                                Margin="0">
                            <Grid Width="14" Height="14">
                                <Line X1="3" Y1="3" X2="11" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                                <Line X1="11" Y1="3" X2="3" Y2="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Masthead -->
            <StackPanel Grid.Row="1" Margin="40,28,40,0" HorizontalAlignment="Center" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Height="1.5" Background="{StaticResource RuleBrush}" />
                        <Border Height="0.5" Background="{StaticResource RuleBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Path Grid.Column="1"
                          Width="10" Height="10" Margin="6,0"
                          Stretch="Uniform"
                          Data="M 0 -4 L 4 0 L 0 4 L -4 0 Z"
                          Fill="{StaticResource RuleBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Height="1.5" Background="{StaticResource RuleBrush}" />
                        <Border Height="0.5" Background="{StaticResource RuleBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource SerifFont}"
                           FontWeight="Bold"
                           FontSize="40"
                           Foreground="{StaticResource InkBrush}"
                           TextAlignment="Center">
                    <Run Text="SIMPLE" /><Run Text="  ·  " Foreground="{StaticResource RuleBrush}" /><Run Text="TIME" /><Run Text="  ·  " Foreground="{StaticResource RuleBrush}" /><Run Text="COUNTDOWN" />
                </TextBlock>

                <Grid HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Height="0.5" Background="{StaticResource RuleBrush}" />
                        <Border Height="1.5" Background="{StaticResource RuleBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Path Grid.Column="1"
                          Width="10" Height="10" Margin="6,0"
                          Stretch="Uniform"
                          Data="M 0 -4 L 4 0 L 0 4 L -4 0 Z"
                          Fill="{StaticResource RuleBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Height="0.5" Background="{StaticResource RuleBrush}" />
                        <Border Height="1.5" Background="{StaticResource RuleBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           FontFamily="{StaticResource SerifFont}"
                           FontStyle="Italic"
                           FontSize="12"
                           Foreground="{StaticResource InkSoftBrush}"
                           Text="{Binding [Casebook.Subtitle], Source={StaticResource Loc}}" />

                <TextBlock HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           FontFamily="{StaticResource SerifFont}"
                           FontSize="12"
                           Foreground="{StaticResource InkSoftBrush}"
                           Text="{Binding CurrentTimeDisplay}" />

                <Grid Margin="0,18,0,0">
                    <Border Height="1" Background="{StaticResource RuleBrush}" Opacity="0.7" />
                    <Border HorizontalAlignment="Center" Background="{StaticResource PaperBrush}" Padding="8,0">
                        <TextBlock Text="❦" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource RuleBrush}" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Search row — hidden by default, toggled by the magnifier in the chrome bar -->
            <Grid Grid.Row="2" x:Name="SearchRow" Margin="40,18,40,0" Visibility="Collapsed">
                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource SearchTextBox}"
                         ToolTip="{Binding [Main.Search.Tooltip], Source={StaticResource Loc}}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="3"
                  Margin="40,40,40,40"
                  Visibility="{Binding HasVisibleItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource SerifFont}"
                           FontStyle="Italic"
                           FontSize="14"
                           Foreground="{StaticResource InkSoftBrush}"
                           Text="{Binding [Main.Empty], Source={StaticResource Loc}}" />
            </Grid>

            <ListBox Grid.Row="4"
                     Margin="32,16,32,0"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource InkBrush}"
                     ItemsSource="{Binding ItemsView}"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ParchmentScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:CountdownItemViewModel}">
                        <Grid Margin="0,0,0,18">
                            <Border x:Name="CardBg" Background="Transparent" />
                            <StackPanel Margin="6,8,6,12">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Margin="0,0,8,0"
                                               Style="{StaticResource SectionMarker}"
                                               Foreground="{Binding StatusAccentBrush}"
                                               Text="—" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource SectionMarker}"
                                               Foreground="{Binding StatusAccentBrush}"
                                               Text="—" />
                                    <TextBlock Style="{StaticResource SectionMarker}"
                                               Foreground="{Binding StatusAccentBrush}"
                                               Text="{Binding StatusBadgeText}" />
                                </DockPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontFamily="{StaticResource SerifFont}"
                                                   FontWeight="SemiBold"
                                                   FontSize="28"
                                                   Foreground="{StaticResource InkBrush}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource BodyItalic}"
                                                   Text="{Binding SubtitleWithDash}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource SmallCapsLabel}"
                                                   Text="{Binding RomanDeadlineDisplay}" />
                                    </StackPanel>
                                    <!-- Equal-sized day/hr numerals, both in status color -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,4,0,0">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock FontFamily="{StaticResource SerifFont}"
                                                       FontWeight="Bold"
                                                       FontSize="40"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{Binding StatusAccentBrush}"
                                                       Text="{Binding PrimaryUnitsLeading}" />
                                            <TextBlock Style="{StaticResource SmallCapsLabel}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding PrimaryUnitsLeadingLabel}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontFamily="{StaticResource SerifFont}"
                                                       FontWeight="Bold"
                                                       FontSize="40"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{Binding StatusAccentBrush}"
                                                       Text="{Binding PrimaryUnitsTrailing}" />
                                            <TextBlock Style="{StaticResource SmallCapsLabel}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding PrimaryUnitsTrailingLabel}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Cigar (only when not archived) -->
                                <controls:CigarCountdown x:Name="CigarBar"
                                                         Margin="0,12,0,0"
                                                         Height="118"
                                                         Progress="{Binding ProgressFraction}"
                                                         AccentBrush="{Binding StatusAccentBrush}" />

                                <!-- Postal cancellation stamp (only when archived) -->
                                <Grid x:Name="ArchiveStamp"
                                      Margin="0,16,0,8"
                                      Height="138"
                                      Visibility="Collapsed">
                                    <controls:PostalStamp HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Width="138"
                                                          Height="138"
                                                          Opacity="0.88"
                                                          Stroke="{StaticResource StatusUrgentBrush}"
                                                          StampFontFamily="{StaticResource SerifFont}"
                                                          TopText="{Binding ArchiveStampTopLabel}"
                                                          BottomText="{Binding ArchiveStampBottomLabel}"
                                                          DateText="{Binding ArchiveStampDateLabel}">
                                        <controls:PostalStamp.LayoutTransform>
                                            <RotateTransform Angle="-7" />
                                        </controls:PostalStamp.LayoutTransform>
                                    </controls:PostalStamp>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" x:Name="LapsedBlock">
                                        <TextBlock FontFamily="{StaticResource SerifFont}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource InkBrush}"
                                                   Text="{Binding LapsedPercentDisplay}" />
                                        <TextBlock Style="{StaticResource SmallCapsLabel}"
                                                   Text="{Binding LapsedLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                x:Name="ActionRow"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Opacity="0.35">
                                        <Button Style="{StaticResource CardActionIconButton}"
                                                Click="ArchiveCountdown_Click"
                                                ToolTip="{Binding ArchiveActionTooltip}"
                                                Visibility="{Binding IsArchived, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.1"
                                                  Fill="Transparent"
                                                  Data="M 2 3 L 14 3 L 14 6 L 2 6 Z M 3 6 L 13 6 L 13 14 L 3 14 Z M 6 9 L 10 9" />
                                        </Button>
                                        <Button Style="{StaticResource CardActionIconButton}"
                                                Click="EditCountdown_Click"
                                                ToolTip="{Binding [Common.Edit], Source={StaticResource Loc}}"
                                                Visibility="{Binding IsArchived, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <!-- Fountain pen / quill -->
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.1"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Data="M 12 2 L 14 4 L 6 12 L 3 13 L 4 10 Z M 4 10 L 6 12 M 11 3 L 13 5" />
                                        </Button>
                                        <Button Style="{StaticResource CardActionIconButton}"
                                                Click="RestoreCountdown_Click"
                                                ToolTip="{Binding RestoreActionTooltip}"
                                                Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.1"
                                                  Fill="Transparent"
                                                  Data="M 3 8 A 5 5 0 1 0 5 4 L 3 4 M 3 4 L 3 1 M 3 4 L 6 4" />
                                        </Button>
                                        <Button Style="{StaticResource CardActionIconButton}"
                                                Click="DeleteCountdown_Click"
                                                ToolTip="{Binding [Common.Delete], Source={StaticResource Loc}}">
                                            <!-- Trash can -->
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.1"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Data="M 4 5 L 12 5 L 11 14 L 5 14 Z M 3 5 L 13 5 M 6 4 L 10 4 L 10 5 L 6 5 Z M 7 8 L 7 12 M 9 8 L 9 12" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource SmallCapsLabel}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding ArchivedAtDisplay}"
                                                   Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Margin="0,14,0,0" Background="{StaticResource RuleBrush}" Opacity="0.4" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                <Setter TargetName="CigarBar" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ArchiveStamp" Property="Visibility" Value="Visible" />
                                <Setter TargetName="LapsedBlock" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="ActionRow" Property="Opacity" Value="1" />
                                <Setter TargetName="CardBg" Property="Background" Value="#10A08850" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="5" Margin="40,12,40,16">
                <TextBlock Style="{StaticResource SmallCapsLabel}" Text="{Binding SummaryText}" />
            </Grid>
        </Grid>
    </Border>
</Window>
