<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Palette ===== -->
    <Color x:Key="ColorPaper">#F0E6D2</Color>
    <Color x:Key="ColorPaperDeep">#E0D4BA</Color>
    <Color x:Key="ColorPaperEdge">#D4C8A8</Color>
    <Color x:Key="ColorWood">#1A0E06</Color>
    <Color x:Key="ColorInk">#2A1A10</Color>
    <Color x:Key="ColorInkSoft">#4A3422</Color>
    <Color x:Key="ColorInkFaint">#7A5A40</Color>
    <Color x:Key="ColorRule">#A08850</Color>
    <Color x:Key="ColorStatusUrgent">#7A2418</Color>
    <Color x:Key="ColorStatusSoon">#8A5A18</Color>
    <Color x:Key="ColorStatusNormal">#3A4A28</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource ColorPaper}" />
    <SolidColorBrush x:Key="PaperDeepBrush" Color="{StaticResource ColorPaperDeep}" />
    <SolidColorBrush x:Key="PaperEdgeBrush" Color="{StaticResource ColorPaperEdge}" />
    <SolidColorBrush x:Key="WoodBrush" Color="{StaticResource ColorWood}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource ColorInkSoft}" />
    <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource ColorInkFaint}" />
    <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource ColorRule}" />
    <SolidColorBrush x:Key="StatusUrgentBrush" Color="{StaticResource ColorStatusUrgent}" />
    <SolidColorBrush x:Key="StatusSoonBrush" Color="{StaticResource ColorStatusSoon}" />
    <SolidColorBrush x:Key="StatusNormalBrush" Color="{StaticResource ColorStatusNormal}" />

    <!-- ===== Fonts (closest Windows-installed equivalents to EB Garamond + Noto Serif SC) ===== -->
    <FontFamily x:Key="SerifFont">Cambria, Georgia, Garamond, "Noto Serif SC", "Microsoft YaHei UI", "SimSun"</FontFamily>
    <FontFamily x:Key="SerifItalicFont">Cambria, Georgia, Garamond, "Noto Serif SC", "Microsoft YaHei UI", "SimSun"</FontFamily>

    <sys:Double x:Key="LetterSpacingSmallCaps">0.18</sys:Double>

    <!-- ===== Generic text styles ===== -->
    <Style x:Key="SmallCapsLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="SectionMarker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    </Style>

    <Style x:Key="BodyItalic" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifItalicFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Ornament: double-rule with diamond ===== -->
    <Style x:Key="DiamondOrnament" TargetType="Path">
        <Setter Property="Data" Value="M 0 -4 L 4 0 L 0 4 L -4 0 Z" />
        <Setter Property="Fill" Value="{StaticResource RuleBrush}" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="ChromeIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="1"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A7A2418" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource StatusUrgentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardActionIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="1"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22A08850" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource StatusUrgentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InkButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InkBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource SerifFont}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A2616" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0F0A06" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource InkButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Plain text-only button. Hover draws an ink-red underline + colour shift,
         as if the word were marked up with a pencil. -->
    <Style x:Key="PencilButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,1.4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource StatusUrgentBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource StatusUrgentBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker text area: parchment background to blend with the sheet. -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="0,4,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ===== TextBox ===== -->
    <Style x:Key="ParchmentTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource RuleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="0,8,0,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource ParchmentTextBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style x:Key="ParchmentComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaperDeepBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PaperEdgeBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ParchmentComboBoxToggle" TargetType="ToggleButton">
        <Border x:Name="Bd"
                Background="Transparent"
                BorderBrush="{StaticResource InkSoftBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Margin="0,6,0,4"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                <Path Grid.Column="1"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,2,0"
                      Data="M 0 0 L 8 0 L 4 5 Z"
                      Fill="{StaticResource InkSoftBrush}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ParchmentComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ParchmentComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ParchmentComboBoxToggle}"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="0,2,18,2"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </ToggleButton>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{StaticResource PaperBrush}"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Padding="0">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style x:Key="ParchmentCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                x:Name="Box"
                                Width="14" Height="14"
                                Margin="0,2,8,0"
                                Background="Transparent"
                                BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="1">
                            <Path x:Name="Mark"
                                  Data="M 1 5 L 5 9 L 12 1"
                                  Stroke="{StaticResource StatusUrgentBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource StatusUrgentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider ===== -->
    <Style x:Key="ParchmentSliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14">
                        <Ellipse Fill="{StaticResource PaperDeepBrush}"
                                 Stroke="{StaticResource InkBrush}"
                                 StrokeThickness="1" />
                        <Ellipse Width="4" Height="4" Fill="{StaticResource InkBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParchmentSlider" TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource PaperEdgeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="2" VerticalAlignment="Center"
                                Background="{StaticResource PaperEdgeBrush}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ParchmentSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar ===== -->
    <Style x:Key="ParchmentScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource InkSoftBrush}"
                            CornerRadius="1"
                            Margin="2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParchmentScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ParchmentScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
