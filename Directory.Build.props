<Project>
  <!--
    The product version, and its only definition. Bump VersionPrefix and nothing else: the assembly,
    file and informational versions derive from it here, and the release scripts read it for the MSIX
    package version (major.minor.patch.0). Keep it a literal major.minor.patch number, since the scripts
    read this file directly rather than evaluating MSBuild.
  -->
  <PropertyGroup>
    <VersionPrefix>2.0.0</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The UI is English and Simplified Chinese only; don't ship the framework's resources for other languages. -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <!-- Reproducible, path-independent builds on CI. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
